# Required for the admin panel at /admin
ADMIN_PASSWORD=
# 32+ random characters, e.g. `openssl rand -base64 32`
AUTH_SECRET=

# Optional: store content and messages in MongoDB (needed on Vercel).
# Without it, data is saved to .data/*.json, which is fine for local dev.
MONGODB_URI=
MONGODB_DB=portfolio

# Optional: email each contact-form message to you via Resend (resend.com)
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Optional: raises the GitHub API rate limit for the repos section
GITHUB_TOKEN=
